{
  "experiment_name": "grdc_cooperative_navigation_v2_no_pruning",
  "seed": 1,
  "device": "auto",
  "environment": {
    "name": "cooperative_navigation",
    "n_agents": 5,
    "n_targets": 5,
    "episode_limit": 50,
    "vision_radius": 0.3,
    "world_size": 1.0,
    "agent_speed": 0.1,
    "collision_penalty": 1.0
  },
  "model": {
    "hidden_dim": 128,
    "attention_dim": 64,
    "n_prototypes": 10,
    "min_prototypes": 1,
    "gumbel_temperature_start": 1.0,
    "gumbel_temperature_end": 0.1,
    "paper_equations": true,
    "stable_role_attention": true,
    "include_previous_action": true
  },
  "training": {
    "total_steps": 10000000,
    "rollout_steps": 1024,
    "update_epochs": 10,
    "minibatch_chunks": 8,
    "recurrent_chunk_length": 16,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "ppo_clip": 0.2,
    "actor_lr": 0.0005,
    "critic_lr": 0.0005,
    "role_entropy_coef": 0.01,
    "prototype_decorrelation_coef": 0.01,
    "pruning_sensitivity": 0.01,
    "pruning_warmup_steps": 500000,
    "pruning_interval_steps": 250000,
    "eval_interval_steps": 100000,
    "eval_episodes": 32,
    "save_interval_steps": 250000,
    "critic_objective": "td",
    "keep_step_checkpoints": false,
    "enable_pruning": false
  },
  "output_dir": "runs/revised",
  "checkpoint_dir": "checkpoints/revised"
}
